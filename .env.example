# 复制为 .env 后填写

# 必填（不填也能跑，只是 AI 教练用不了）：DeepSeek  https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 内测访问码：留空表示 AI 功能对所有人开放；填写后需要输入访问码才能用 AI（本地分析不受影响）
ACCESS_CODE=

# 后台统计接口 /api/admin/stats?token=xxx 的口令，留空关闭
ADMIN_TOKEN=

# 页面底部公示的模型与登记信息（面向公众上线前，按网信办的生成式 AI 登记结果填写）
MODEL_DISCLOSURE=AI 功能由 DeepSeek 大模型提供

# DeepSeek 单价（元/百万 tokens），只用于成本估算，以控制台账单为准
DEEPSEEK_PRICE_INPUT=2
DEEPSEEK_PRICE_CACHED=0.2
DEEPSEEK_PRICE_OUTPUT=3

# ---------- 成本控制 ----------
# 全站每日 AI 成本上限（元，北京时间零点重置），0 表示不限
DAILY_BUDGET_YUAN=5
# 每台设备每天最多调用 AI 几次
DEVICE_DAILY_CALLS=30
