# 复制为 .env 后填写

# 必填（不填也能跑，只是 AI 教练用不了）：DeepSeek  https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 注册邀请码（内测）：留空表示开放注册。不登录也能用本地分析；AI 教练和每周复盘需要登录
INVITE_CODE=
SITE_URL=https://savewise.waywise.tech

# 这些邮箱注册或登录后自动成为管理员，后台在 /admin（逗号分隔）
ADMIN_EMAILS=
# 可选：脚本调用后台接口 /api/admin/* 用的口令（放在请求头 X-Admin-Token 里），留空则只能登录后用
ADMIN_TOKEN=

# 页面底部公示的模型与登记信息（面向公众上线前，按网信办的生成式 AI 登记结果填写）
MODEL_DISCLOSURE=AI 功能由 DeepSeek 大模型提供

# DeepSeek 单价（元/百万 tokens），只用于成本估算，以控制台账单为准
DEEPSEEK_PRICE_INPUT=2
DEEPSEEK_PRICE_CACHED=0.2
DEEPSEEK_PRICE_OUTPUT=3

# ---------- 成本控制 ----------
# 全站每日 AI 成本上限（元，北京时间零点重置），0 表示不限
DAILY_BUDGET_YUAN=5
# 每个用户每天最多调用 AI 几次（周一的定时复盘不算）
USER_DAILY_CALLS=30

# ---------- 每周复盘 ----------
# 每周一几点生成上周复盘并发邮件（北京时间）
WEEKLY_RUN_TIME=08:00

# 邮件（每周复盘、找回密码）。不填也能用，只是不发邮件、不能找回密码
# QQ 邮箱：SMTP_HOST=smtp.qq.com，SMTP_PASSWORD 填“授权码”（不是 QQ 密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
