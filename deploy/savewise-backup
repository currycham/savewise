#!/bin/sh
# 每天备份 SQLite（账号、云同步密文、每周汇总和复盘、AI 记账）（在线热备份，不停服务），保留 14 天。由 setup-server.sh 安装到 /etc/cron.daily/
set -e
DIR=/srv/savewise/backup
DB=/srv/savewise/data/savewise.db
[ -f "$DB" ] || exit 0
mkdir -p "$DIR"
sqlite3 "$DB" ".backup '$DIR/savewise-$(date +%F).db'"
gzip -f "$DIR/savewise-$(date +%F).db"
find "$DIR" -name 'savewise-*.db.gz' -mtime +14 -delete
chown -R savewise:savewise "$DIR"
