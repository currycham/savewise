# SaveWise 站点：由 setup-server.sh 复制到 /etc/caddy/savewise.caddy，并在主 Caddyfile 里 import
# Caddy 会自动申请和续期 HTTPS 证书（前提：DNS 已解析到本机，80/443 端口已放行）
savewise.waywise.tech {
	encode zstd gzip

	# 账单文件在浏览器里解析，不上传；云同步上传的是压缩加密后的数据，6 年流水通常不到 2MB
	request_body {
		max_size 16MB
	}

	reverse_proxy 127.0.0.1:8200

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
